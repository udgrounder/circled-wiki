{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.circled-wiki.invalid/user-notification/v1",
  "title": "Circled Wiki User Notification",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "notification_id", "event", "priority", "title", "summary", "next_action", "resource_ref", "approval_required", "dedupe_key", "created_at"],
  "properties": {
    "schema_version": { "const": 1 },
    "notification_id": { "type": "string", "pattern": "^notification-[0-9a-f-]{36}$" },
    "event": { "enum": ["bundle_created", "taxonomy_change_proposed", "reclassification_ready", "review_requested"] },
    "priority": { "enum": ["action_required", "attention", "failed"] },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "next_action": { "type": "string", "minLength": 1 },
    "resource_ref": { "type": "string", "minLength": 1 },
    "approval_required": { "type": "boolean" },
    "dedupe_key": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "related_evidence_id": { "type": "string" },
    "related_bundle_id": { "type": "string" },
    "taxonomy_revision": { "type": "string" }
  }
}
