{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "circled-wiki/data-protection/schema/v1",
  "title": "Circled Wiki Data Protection Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "pii_scan", "sensitivity_review"],
  "properties": {
    "schema_version": { "const": 1 },
    "pii_scan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_version"],
      "properties": {
        "policy_version": { "const": "v1" },
        "hard_mask_categories": {
          "oneOf": [
            {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/hardMaskCategory" }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "resident_registration_number": { "type": "boolean" },
                "account_number": { "type": "boolean" },
                "card_number": { "type": "boolean" },
                "credential": { "type": "boolean" },
                "mobile_phone_number": { "type": "boolean" },
                "email_address": { "type": "boolean" }
              }
            }
          ]
        }
      }
    },
    "sensitivity_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_ref", "missing_policy_action"],
      "properties": {
        "policy_ref": { "const": "inbox-sensitivity/v1" },
        "missing_policy_action": { "const": "awaiting_user" },
        "agent_mask_categories": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/maskCategory" }
        }
      }
    }
  },
  "$defs": {
    "hardMaskCategory": {
      "enum": ["resident_registration_number", "account_number", "card_number", "credential", "mobile_phone_number", "email_address"]
    },
    "maskCategory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "include", "exclude"],
      "properties": {
        "description": { "type": "string", "minLength": 1 },
        "include": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "exclude": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
